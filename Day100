import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String S = sc.nextLine();

        int star = 0;
        int hash = 0;

        for (int i = 0; i < S.length(); i++) {
            if (S.charAt(i) == '*') {
                star++;
            } else if (S.charAt(i) == '#') {
                hash++;
            }
        }

        // Positive if * > #
        // Negative if # > *
        // Zero if * = #
        System.out.println(star - hash);

        sc.close();
    }
}
